{
    "name": "spARcl",
    "version": "0.5.0",
    "description": "spARcl (spatial AR cloud client) - Open Spatial Cloud Platform (OSCP) client with WebXR",
    "type": "module",
    "scripts": {
        "dev": "vite --host --port 8080",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "start": "npm run dev",
        "build": "vite build",
        "build:docker": "docker build . -t sparcl",
        "start:docker": "docker run -p 8080:80 -d sparcl:latest",
        "preview": "vite preview --port 8080",
        "test": "node --import ./test/node-polyfills.mjs --import tsx --test test/worldAlignment.test.ts test/frameTransforms.test.ts test/geoPoseProtocolExtended.test.ts test/scrPlacement.test.ts test/cameraFrameBridge.test.ts",
        "lint": "eslint .",
        "format": "prettier --write ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OpenArCloud/sparcl.git"
    },
    "keywords": [
        "oarc",
        "oscp",
        "arcloud"
    ],
    "author": "Gabor Soros, Michael Vogt",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/OpenArCloud/sparcl/issues"
    },
    "homepage": "https://github.com/OpenArCloud/sparcl#readme",
    "allowScripts": {
        "esbuild": true,
        "fsevents": true,
        "browser-tabs-lock": false,
        "cbor-extract": false,
        "core-js": false,
        "svelte-preprocess": false
    },
    "devDependencies": {
        "@rollup/plugin-typescript": "^11.1.5",
        "@sveltejs/vite-plugin-svelte": "^3.0.0",
        "@tsconfig/svelte": "^5.0.2",
        "@types/geodesy": "^2.2.8",
        "@types/leaflet": "^1.9.8",
        "@types/three": "^0.184.0",
        "@types/uuid": "^9.0.7",
        "@types/w3c-generic-sensor": "^1.0.9",
        "@types/webgl2": "^0.0.10",
        "@types/webxr": "^0.5.10",
        "@vitejs/plugin-basic-ssl": "^1.0.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "prettier": "^3.6.2",
        "prettier-plugin-svelte": "^3.4.0",
        "svelte": "^4.2.3",
        "svelte-check": "^4.7.6",
        "tslib": "^2.6.2",
        "tsx": "^4.21.0",
        "typescript": "^5.3.3",
        "vite": "^5.0.0",
        "vite-plugin-glsl": "^1.2.0",
        "vite-plugin-wasm": "^3.3.0"
    },
    "dependencies": {
        "@auth0/auth0-spa-js": "^2.1.3",
        "@automerge/automerge-repo": "^1.1.1",
        "@automerge/automerge-repo-storage-indexeddb": "^1.1.1",
        "@fortawesome/fontawesome-free": "^6.7.2",
        "@loaders.gl/core": "^3.4.13",
        "@loaders.gl/ply": "^3.4.13",
        "@oarc/gpp-access": "^0.2.1",
        "@oarc/scd-access": "^0.5.0",
        "@oarc/ssd-access": "^0.5.0",
        "@stomp/stompjs": "^7.1.0",
        "es-toolkit": "^1.39.10",
        "eventemitter3": "^5.0.1",
        "geodesy": "^2.4.0",
        "gl-matrix": "^3.3.0",
        "h3-js": "^4.2.1",
        "leaflet": "^1.7.1",
        "ogl": "1.0.3",
        "peerjs": "^1.5.5",
        "svelte-awesome-color-picker": "^3.0.4",
        "svelte-routing": "^2.13.0",
        "three": "^0.184.0",
        "uuid": "^8.3.2"
    }
}
